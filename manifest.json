{
  "manifest_version": 3,
  "name": "NetSuite Field ID Helper",
  "version": "0.2.6",
  "description": "Copy NetSuite field IDs and search records by a field's current value from Field Help.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netsuite.com/*"],
      "js": ["src/search.js", "src/custom-field.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.netsuite.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
